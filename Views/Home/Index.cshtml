
@{
    ViewData["Title"] = "Inicio";
}

<!-- Presentación principal -->
<section class="mb-5">

    <div class="card shadow-sm border-light-subtle">
        <div class="card-body text-center p-5">

            <h1 class="display-5 fw-bold">
                Bienvenido a NEXORA
            </h1>

            <h2 class="h4 text-primary mb-3">
                Tu mundo tecnológico comienza aquí
            </h2>

            <p class="text-muted">
                Descubre nuestra variedad de productos tecnológicos.
                Encuentra celulares, computadores, accesorios,
                componentes y artículos gaming de las mejores marcas.
            </p>

            <a href="/Productos/Index" class="btn btn-primary mt-3">
                Explorar productos
            </a>

        </div>
    </div>

</section>

<!-- Categorías -->
<section class="mb-5">

    <h2 class="h3 mb-4">Nuestras categorías</h2>

    <div class="row g-3">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="h5">Celulares</h3>
                    <p>Encuentra smartphones de diferentes marcas y modelos.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="h5">Computadores</h3>
                    <p>Equipos portátiles y de escritorio para todas tus necesidades.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="h5">Accesorios</h3>
                    <p>Audífonos, teclados, mouse, cargadores y mucho más.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="h5">Gaming</h3>
                    <p>Todo lo que necesitas para mejorar tu experiencia de juego.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h3 class="h5">Componentes</h3>
                    <p>Procesadores, memorias RAM, tarjetas gráficas y SSD.</p>
                </div>
            </div>
        </div>

    </div>

</section>

<!-- Ventajas -->
<section class="mb-5">

    <div class="card shadow-sm border-light-subtle">
        <div class="card-body">

            <h2 class="h3 mb-4">¿Por qué elegir NEXORA?</h2>

            <p> Variedad de productos tecnológicos.</p>

            <p> Marcas reconocidas en el mercado.</p>

            <p> Atención personalizada.</p>

            <p> Soluciones tecnológicas para todos.</p>

        </div>
    </div>

</section>

<!-- Promociones -->
<section class="mb-5">

    <div class="card bg-primary text-white shadow-sm">
        <div class="card-body text-center p-4">

            <h2 class="h3">¡Descubre nuestras ofertas!</h2>

            <p>
                Encuentra promociones y productos tecnológicos
                que se adaptan a tus necesidades.
            </p>

            <a href="/Ofertas/Index" class="btn btn-light">
                Ver ofertas
            </a>

        </div>
    </div>

</section>

