@{
    ViewData["Title"] = "Productos";
}
<h1>@ViewData["Title"]</h1>

 <section id="Computadores" class="mb-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h3 class="card-title h5">Computadores</h3>
                                <p class="card-text text-secondary mb-0">
                                    Encuentra computadores diseñados para estudiar, trabajar, crear y disfrutar de tus videojuegos favoritos.
                                    En NEXORA ofrecemos equipos con diferentes características y precios para adaptarse a tus necesidades.
                                </p>
                            </div>
                        </div>

                        <div class="table-responsive mt-3">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col">Producto</th>
                                        <th scope="col">Características</th>
                                        <th scope="col">Precio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>NEXORA Basic</td>
                                        <td>Intel i5 · 8 GB RAM · 256 GB SSD</td>
                                        <td>$799.900</td>
                                    </tr>
                                    <tr>
                                        <td>NEXORA Pro</td>
                                        <td>Intel i7 · 16 GB RAM · 512 GB SSD</td>
                                        <td>$1.399.900</td>
                                    </tr>
                                    <tr>
                                        <td>NEXORA Ultra</td>
                                        <td>Ryzen 7 · 32 GB RAM · RTX</td>
                                        <td>$2.499.900</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <a href="#" class="btn btn-primary mb-4">Me interesa un producto</a>
                    </section>

